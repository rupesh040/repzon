            "image": "/faqs.webp",
            "items": [
              {
                "question": "What are your gym membership plans?",
                "answer": "We offer flexible membership plans including monthly, quarterly, half-yearly, and annual options. Each plan gives you access to our gym, classes, and basic facilities."
              },
              {
                "question": "Do you offer personal training?",
                "answer": "Yes, we offer tailored 1-on-1 personal training sessions with certified fitness coaches who design customized workout and nutrition programs for your goals."
              },
              {
                "question": "Are group fitness classes included in the membership?",
                "answer": "Yes, all active members enjoy complimentary access to our full schedule of group classes including HIIT, Strength Training, Yoga, and Functional Conditioning."
              },
              {
                "question": "What are the gym's operating hours?",
                "answer": "Repzon operates 24/7 with keycard access for members. Staffed consultation and training hours run Monday through Saturday from 6:00 AM to 10:00 PM."
              },
              {
                "question": "Is there a trial workout available?",
                "answer": "Yes, we provide a free 3-day guest pass allowing you to experience our state-of-the-art facility, test equipment, and attend any scheduled group class."
              }
            ]
          }
        }
